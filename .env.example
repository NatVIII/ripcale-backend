# ripcale secrets & overrides — copy to .env and adjust.
#
# API keys and secrets go here, NOT in config.yaml.
# Any RIPCALE_* value set here overrides config.yaml.

# Overrides (optional — config.yaml provides defaults)
# RIPCALE_PUBLIC_HOST=0.0.0.0
# RIPCALE_PUBLIC_PORT=8081
# RIPCALE_ADMIN_HOST=127.0.0.1
# RIPCALE_ADMIN_PORT=8082
# RIPCALE_DATA_DIR=data
# RIPCALE_DATABASE_URL=sqlite:///data/ripcale.db
# RIPCALE_CORS_ORIGINS=*
# RIPCALE_DEBUG_ALLOWED_CIDRS=10.0.0.0/8,192.168.1.0/24
# RIPCALE_DEBUG_TOKEN=change-me

# API keys (future)
# RIPCALE_INSTAGRAM_TOKEN=
