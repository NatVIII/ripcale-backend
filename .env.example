# ripcale auth + secrets — copy to .env and adjust.
#
# `config.yaml` is the single source of truth for SYSTEM settings. `.env` holds
# ONLY auth + secrets (below) and does NOT override config.yaml.

# Admin login (bootstrap)
RIPCALE_ADMIN_USERNAME=admin
# argon2id hash — generate with: python -m app.auth hash-password
# Ensure you use single quotes for encapsulating the string (i.e. use 'content' and not "context")
RIPCALE_ADMIN_PASSWORD_HASH=
# Optional pepper keyed into every password before hashing.
# Generate with: python -m app.auth gen-pepper  (changing it invalidates existing hashes)
# Ensure you use single quotes for encapsulating the string (i.e. use 'content' and not "context")
RIPCALE_PEPPER=

# API keys
# Ensure you use single quotes for encapsulating the string (i.e. use 'content' and not "context")
RIPCALE_HIKERAPI_KEY=
# Ensure you use single quotes for encapsulating the string (i.e. use 'content' and not "context")
# Sorry, I'm not really providing an openAPI frontend thing; I'm caging you into Deepseek. I like deepseek and it's good for the environment as far as I'm aware, or atleast better than 美帝AI
RIPCALE_DEEPSEEK_KEY=
